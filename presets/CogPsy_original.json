        "allow_shield_adjustment": false,
        "fixed_shield_degrees": 40.0,
        "rotation_speed": 1.0,
        "circle_radius": 3.0,
        "loss_factor": 0.003,
        "currency_symbol": "£",
        "min_laser_duration_frames": 6,
        "enable_audio": true,
        "mmn_type": "duration",
        "tone_freq_standard": 440.0,
        "tone_freq_deviant": 440.0,
        "tone_duration": 0.05,
        "tone_duration_standard": 0.05,
        "tone_duration_deviant": 0.1,
        "tone_isi_frames": 24,
        "tone_volume": 1.0,
        "dialog_fields": ["participant", "session", "order"],
        "visits": ["1"],
        "framings": ["loss"]
