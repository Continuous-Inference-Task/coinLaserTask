{
    "name": "SLEPS_default",
    "description": "SLEPS study — fixed 20° shield, duration MMN, loss/win framing, EEG-friendly",
    "experiment": {
        "target_os": "windows",
        "window_size": [
            1512,
            982
        ],
        "fullscreen": true,
        "screen_index": 0,
        "monitor_name": "testMonitor",
        "target_refresh_rate": 60,
        "key_right": "j",
        "key_left": "f",
        "input_device": "keyboard",
        "keyboard_backend": "",
        "use_legacy_key_tracking": true,
        "rotation_speed": 1.0,
        "circle_radius": 3.0,
        "allow_shield_adjustment": false,
        "fixed_shield_degrees": 20.0,
        "loss_factor": 0.003,
        "currency_symbol": "€",
        "neutral_practice": true,
        "trigger_mode": "lsl",
        "serial_port": "/dev/ttyUSB0",
        "serial_baud_rate": 115200,
        "parallel_address": "/dev/parport0",
        "enable_audio": true,
        "mmn_type": "frequency",
        "show_earth_background": false,
        "show_rbar": false,
        "show_source": false,
        "round_pbar": true,
        "flash_feedback": true,
        "tone_freq_standard": 440.0,
        "tone_freq_deviant": 528.0,
        "tone_duration": 0.07,
        "tone_duration_standard": 0.07,
        "tone_duration_deviant": 0.07,
        "tone_volume": 1.0,
        "tone_isi_frames": 26,
        "enable_practice": true,
        "reset_reward_after_practice": true,
        "min_laser_duration_frames": 6,
        "visits": [
            "1",
            "2"
        ],
        "sessions": [
            "1"
        ],
        "orders": [
            "1",
            "2",
            "3",
            "4"
        ],
        "framings": [
            "loss",
            "win"
        ],
        "dialog_fields": [
            "participant",
            "visit",
            "session",
            "order",
            "framing",
            "practice_mode",
            "trigger_mode"
        ]
    },
    "stimgen": {
        "SAMPLE_RATE": 60,
        "VOLATILITY_PRESETS": {
            "stable": [
                8,
                1.5,
                5,
                10
            ],
            "volatile": [
                3,
                1.5,
                2,
                5
            ],
            "medium": [
                5,
                1.5,
                3,
                10
            ]
        },
        "NOISE_PRESETS": {
            "precise": 15,
            "noisy": 25
        },
        "PRACTICE_VOLATILITY": [
            "stable",
            "medium"
        ],
        "PRACTICE_NOISE": [
            "precise"
        ],
        "PRACTICE_NOISE_MODE": "counterbalanced",
        "PRACTICE_N_SESSIONS": 1,
        "PRACTICE_BLOCK_DURATION_MIN": 2,
        "MAIN_VOLATILITY": [
            "stable",
            "volatile"
        ],
        "MAIN_NOISE": [
            "precise",
            "noisy"
        ],
        "MAIN_NOISE_MODE": "counterbalanced",
        "MAIN_N_SESSIONS": 1,
        "MAIN_BLOCK_DURATION_MIN": 4,
        "SAVED_DESIGNS": {},
        "JUMP_DURATION_MEAN_SEC": 0.3,
        "JUMP_DURATION_MIN_SEC": 0.075,
        "JUMP_DURATION_MAX_SEC": 1.0,
        "JUMP_VALUE_SET": [
            -40,
            -30,
            -20,
            20,
            30,
            40
        ],
        "SHOW_SOURCE": false
    }
}
